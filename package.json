{
  "name": "onestepchess",
  "version": "0.0.0",
  "description": "One Step Chess TypeScript monorepo",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:testnet": "pnpm --filter @onestepchess/server exec tsx src/dev-testnet.ts",
    "dev:playtest": "OSC_CONFIG_PATH=\"$PWD/osc.playtest.config.json\" pnpm -r --parallel run dev",
    "lint": "biome ci .",
    "typecheck": "tsc -b && tsc --noEmit -p packages/web",
    "test": "vitest run",
    "test:tarballs": "node scripts/package-tarball-smoke.mjs",
    "smoke:mcp": "node scripts/mcp-local-smoke.mjs",
    "test:docker": "./scripts/docker-smoke.sh",
    "test:release3:docker": "./scripts/release3-docker-smoke.sh",
    "release4:agent-artifact": "node scripts/release4-agent-artifact.mjs",
    "release4:verify-promotion": "pnpm --filter @onestepchess/e2e verify:release4:promotion",
    "build": "tsc -b && pnpm --filter @onestepchess/web build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.0"
  }
}
