{
  "name": "onestepchess",
  "version": "0.0.0",
  "description": "One Step Chess TypeScript monorepo",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "lint": "biome ci .",
    "typecheck": "tsc -b && tsc --noEmit -p packages/web",
    "test": "vitest run",
    "build": "tsc -b && pnpm --filter @onestepchess/web build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.0"
  }
}
