{
  "name": "@onestepchess/e2e",
  "version": "0.1.0",
  "description": "End-to-end and mainnet smoke tests for One Step Chess",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "pnpm --dir .. exec vitest run --project @onestepchess/e2e",
    "test:e2e": "playwright test",
    "release3_soak_64x100x10000": "tsx src/release3-soak.ts release3_soak_64x100x10000",
    "smoke:t1": "pnpm --dir .. exec tsx e2e/src/release4-chain-smoke.ts testnet",
    "smoke:release4:testnet": "pnpm --dir .. exec tsx e2e/src/release4-chain-smoke.ts testnet",
    "smoke:release4:mainnet": "pnpm --dir .. exec tsx e2e/src/release4-chain-smoke.ts mainnet",
    "verify:release4:evidence": "pnpm --dir .. exec tsx e2e/src/verify-release4-evidence.ts"
  },
  "devDependencies": {
    "@onestepchess/agent-kit": "workspace:*",
    "@onestepchess/core": "workspace:*",
    "@onestepchess/rail-avm": "workspace:*",
    "@onestepchess/rail-mock": "workspace:*",
    "@onestepchess/server": "workspace:*",
    "@playwright/test": "^1.0.0",
    "@x402-avm/avm": "^2.6.0",
    "algosdk": "^3.0.0",
    "tsx": "^4.0.0",
    "vitest": "^4.0.0",
    "zod": "^4.0.0"
  }
}
