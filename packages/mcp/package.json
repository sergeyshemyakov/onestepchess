{
  "name": "@onestepchess/mcp",
  "version": "0.1.0",
  "description": "MCP server for One Step Chess agents",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "pnpm --dir ../.. exec vitest run --project @onestepchess/mcp"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "bin": {
    "osc-mcp": "./dist/stdio.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@onestepchess/agent-kit": "workspace:*",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "vitest": "^4.0.0"
  }
}
