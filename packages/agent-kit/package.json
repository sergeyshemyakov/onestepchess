{
  "name": "@onestepchess/agent-kit",
  "version": "0.1.0",
  "description": "Typed One Step Chess client, wallet, and payment toolkit for agents",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "pnpm --dir ../.. exec vitest run --project @onestepchess/agent-kit"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "bin": {
    "osc-agent": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@x402-avm/avm": "^2.6.0",
    "@x402-avm/core": "^2.6.0",
    "algosdk": "^3.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "vitest": "^4.0.0"
  }
}
